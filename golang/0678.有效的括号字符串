package main

func checkValidString(s string) bool {
    minCount, maxCount := 0, 0
    for _, c := range s {
        if c == '(' {
            minCount++
            maxCount++
        } else if c == ')' {
            minCount = max(minCount-1, 0)
            maxCount--
            if maxCount < 0 {
                return false
            }
        } else {
            minCount = max(minCount-1, 0)
            maxCount++
        }
    }
    return minCount == 0
}

func max(x, y int) int {
    if x > y {
        return x
    }
    
    return y
}
